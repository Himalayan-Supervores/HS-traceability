# PostgreSQL connection string.
# Local Docker example:       postgresql://postgres:postgres@localhost:5432/himalayan_supervores
# Neon / Supabase (free tier): postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/himalayan_supervores"

# Secret used to sign the admin session cookie. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-byte-secret"

# Seed-only: credentials for the first admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@himalayansupervores.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Public base URL of this deployment. Used as the fallback GS1 Digital Link
# domain if none is set yet in the Settings table (Admin > Settings).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
